# NeoST for RetroArch — colour TV fed RGB through a Péritel (SCART) lead from the ST monitor port.
# [F] 5.5 MHz: an order of magnitude for an analog SCART lead, not a measurement; it softens 640-dot medium resolution.

shaders = 5

shader0 = shaders/neost-cable.slang
alias0 = NeoSTCable
filter_linear0 = true
wrap_mode0 = clamp_to_edge
scale_type0 = source
scale0 = 1.0

shader1 = shaders/neost-bloom-h.slang
filter_linear1 = true
wrap_mode1 = clamp_to_edge
scale_type1 = source
scale1 = 1.0

shader2 = shaders/neost-bloom-v.slang
filter_linear2 = true
wrap_mode2 = clamp_to_edge
scale_type2 = source
scale2 = 1.0

shader3 = shaders/neost-glass.slang
alias3 = NeoSTGlass
filter_linear3 = true
wrap_mode3 = clamp_to_edge
scale_type3 = viewport
scale3 = 1.0

shader4 = shaders/neost-present.slang
filter_linear4 = false
scale_type4 = viewport
scale4 = 1.0

parameters = "NEOST_MONITOR;NEOST_RGB_BANDWIDTH;NEOST_SCANLINES;NEOST_SHADOW_MASK;NEOST_SHADOW_STRENGTH;NEOST_BARREL;NEOST_LUMINANCE_GAIN"
NEOST_MONITOR = 1.0
NEOST_RGB_BANDWIDTH = 5.5
NEOST_SCANLINES = 0.40
NEOST_SHADOW_MASK = 2.0
NEOST_SHADOW_STRENGTH = 0.30
NEOST_BARREL = 0.06
NEOST_LUMINANCE_GAIN = 1.30
