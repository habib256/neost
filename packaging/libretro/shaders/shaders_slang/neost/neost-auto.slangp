# NeoST for RetroArch — the monitor follows the picture: SC1224 colour for 200 lines, SM124 mono for 400.
# The desktop CRT pass (src/gui/CrtEffectStack.cpp), ported to slang. Every value is adjustable live
# in Quick Menu > Shaders > Shader Parameters.

shaders = 5

shader0 = shaders/neost-cable.slang
alias0 = NeoSTCable
filter_linear0 = true
wrap_mode0 = clamp_to_edge
scale_type0 = source
scale0 = 1.0

shader1 = shaders/neost-bloom-h.slang
filter_linear1 = true
wrap_mode1 = clamp_to_edge
scale_type1 = source
scale1 = 1.0

shader2 = shaders/neost-bloom-v.slang
filter_linear2 = true
wrap_mode2 = clamp_to_edge
scale_type2 = source
scale2 = 1.0

shader3 = shaders/neost-glass.slang
alias3 = NeoSTGlass
filter_linear3 = true
wrap_mode3 = clamp_to_edge
scale_type3 = viewport
scale3 = 1.0

shader4 = shaders/neost-present.slang
filter_linear4 = false
scale_type4 = viewport
scale4 = 1.0
